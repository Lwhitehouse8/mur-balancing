rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /readings/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['t', 'high', 'low', 'avg', 'note'])
        && request.resource.data.t is number
        && request.resource.data.high is number && request.resource.data.high >= 2.5 && request.resource.data.high <= 4.25
        && request.resource.data.low is number && request.resource.data.low >= 2.5 && request.resource.data.low <= 4.25
        && (!('avg' in request.resource.data) || request.resource.data.avg is number)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
    }
    match /settings/assumptions {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['cap', 'R', 'duty', 'start', 'end', 'look']);
    }
  }
}
